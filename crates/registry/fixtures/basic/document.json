{
  "schema": "shikumi.registry",
  "version": {
    "major": 1,
    "minor": 0
  },
  "focus": null,
  "projects": {
    "core": {
      "directory": "libs/core",
      "summary": "The shared core library",
      "maintainers": [
        "core-team"
      ],
      "dependsOn": [],
      "imports": {},
      "packages": [],
      "env": {},
      "toolchains": {
        "jdk": {
          "description": "The JDK every JVM project builds and runs with",
          "packages": [
            "jdk"
          ],
          "env": {
            "JAVA_HOME": {
              "package": "jdk",
              "path": null
            }
          }
        }
      },
      "steps": {
        "build": {
          "description": "Compile the library",
          "after": []
        },
        "test": {
          "description": "Run the unit tests",
          "after": [
            "build"
          ]
        }
      },
      "commands": {},
      "services": {},
      "extensions": {
        "team": {
          "owner": "platform",
          "tier": "critical"
        }
      }
    },
    "docs": {
      "directory": "docs",
      "summary": "The documentation site",
      "maintainers": [
        "writers"
      ],
      "dependsOn": [
        "web"
      ],
      "imports": {},
      "packages": [
        "mdbook"
      ],
      "env": {
        "DOCS_PORT": "3000"
      },
      "toolchains": {},
      "steps": {},
      "commands": {
        "preview": {
          "description": "Preview the docs"
        }
      },
      "services": {},
      "extensions": {
        "layout": {
          "pages": [
            "pages/**/*.md"
          ]
        }
      }
    },
    "web": {
      "directory": "apps/web",
      "summary": "The web front end",
      "maintainers": [
        "web-team",
        "design"
      ],
      "dependsOn": [
        "core"
      ],
      "imports": {
        "jdk": "core"
      },
      "packages": [
        "kotlin",
        "nodejs"
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "toolchains": {},
      "steps": {
        "bundle": {
          "description": "Bundle the site",
          "after": []
        }
      },
      "commands": {
        "serve": {
          "description": "Serve the site locally"
        }
      },
      "services": {
        "database": {
          "description": "A local database for development",
          "restart": "on-failure"
        }
      },
      "extensions": {
        "team": {
          "owner": "web"
        }
      }
    }
  },
  "catalog": {
    "systems": [
      "x86_64-linux",
      "aarch64-darwin"
    ],
    "packages": {
      "jdk": "jdk21",
      "kotlin": "kotlin",
      "mdbook": "mdbook",
      "nodejs": "nodejs"
    },
    "overrides": {
      "kotlin": {
        "reason": "Kotlin runs on the JDK every JVM project builds with, not the one nixpkgs picks for it",
        "release": "nixpkgs' own choice of JDK for Kotlin is the repository's"
      }
    }
  },
  "remainder": {
    "excludes": [
      "apps/web",
      "docs",
      "libs/core"
    ]
  },
  "diagnostics": []
}
